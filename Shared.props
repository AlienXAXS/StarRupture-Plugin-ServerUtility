<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- ============================================================
       Default paths for local development.
       Override in CI via /p:GameSDKRoot=... /p:PluginSDKInclude=...
       ============================================================ -->
  <PropertyGroup>
    <GameSDKRoot Condition="'$(GameSDKRoot)' == ''">$(MSBuildThisFileDirectory)..\StarRupture-Game-SDK</GameSDKRoot>
    <PluginSDKInclude Condition="'$(PluginSDKInclude)' == ''">$(MSBuildThisFileDirectory)..\StarRupture-Plugin-SDK\include</PluginSDKInclude>
  </PropertyGroup>

  <!-- ============================================================
       StarRuptureSDKSourceDir
       Points to the SDK subdirectory containing Basic.cpp,
       CoreUObject_functions.cpp and Engine_functions.cpp.
       ============================================================ -->
  <!-- Plain Debug / Release name no game target, so they are not built:
       they used to fall through to the Server dump without saying so. -->
  <Target Name="RejectPlainConfiguration" BeforeTargets="PrepareForBuild"
          Condition="'$(Configuration)' == 'Debug' Or '$(Configuration)' == 'Release'">
    <Error Text="ServerUtility builds the Server configurations only. Use 'Server Debug' or 'Server Release' (/p:Configuration=&quot;Server Release&quot;); '$(Configuration)' does not name a game target." />
  </Target>
  <PropertyGroup Condition="'$(Configuration)' == 'Client Debug' Or '$(Configuration)' == 'Client Release' Or '$(Configuration)' == 'Local SDK Client Debug' Or '$(Configuration)' == 'Local SDK Client Release'">
    <StarRuptureSDKSourceDir>$(GameSDKRoot)\Client\SDK\</StarRuptureSDKSourceDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Server Debug' Or '$(Configuration)' == 'Server Release' Or '$(Configuration)' == 'Local SDK Server Debug' Or '$(Configuration)' == 'Local SDK Server Release'">
    <StarRuptureSDKSourceDir>$(GameSDKRoot)\Server\SDK\</StarRuptureSDKSourceDir>
  </PropertyGroup>

  <!-- ============================================================
       StarRuptureSDKConfigDir
       Additional include directories for Client/Server builds.
       ============================================================ -->
  <PropertyGroup Condition="'$(Configuration)' == 'Client Debug' Or '$(Configuration)' == 'Client Release' Or '$(Configuration)' == 'Local SDK Client Debug' Or '$(Configuration)' == 'Local SDK Client Release'">
    <StarRuptureSDKConfigDir>$(GameSDKRoot)\Client\;$(GameSDKRoot)\Client\SDK\</StarRuptureSDKConfigDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Server Debug' Or '$(Configuration)' == 'Server Release' Or '$(Configuration)' == 'Local SDK Server Debug' Or '$(Configuration)' == 'Local SDK Server Release'">
    <StarRuptureSDKConfigDir>$(GameSDKRoot)\Server\;$(GameSDKRoot)\Server\SDK\</StarRuptureSDKConfigDir>
  </PropertyGroup>

  <!-- ============================================================
       MODLOADER_CLIENT_BUILD / MODLOADER_SERVER_BUILD
       ============================================================ -->
  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Client Debug' Or '$(Configuration)' == 'Client Release' Or '$(Configuration)' == 'Local SDK Client Debug' Or '$(Configuration)' == 'Local SDK Client Release'">
    <ClCompile>
      <PreprocessorDefinitions>MODLOADER_CLIENT_BUILD;PLUGIN_NEEDS_INTERFACE=80;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Server Debug' Or '$(Configuration)' == 'Server Release' Or '$(Configuration)' == 'Local SDK Server Debug' Or '$(Configuration)' == 'Local SDK Server Release'">
    <ClCompile>
      <PreprocessorDefinitions>MODLOADER_SERVER_BUILD;PLUGIN_NEEDS_INTERFACE=79;PLUGIN_OPTIONAL_INTERFACE=83;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- ============================================================
       MODLOADER_BUILD_TAG
       Injected by CI via /p:ModLoaderBuildTag="vX.Y.Z".
       ============================================================ -->
  <ItemDefinitionGroup Condition="'$(ModLoaderBuildTag)' != ''">
    <ClCompile>
      <PreprocessorDefinitions>MODLOADER_BUILD_TAG="$(ModLoaderBuildTag)";%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- ============================================================
       PLUGIN_GAME_BUILT_CL
       The game build (CL) the Game-SDK was generated from, read by
       PluginGameBuild.props (Plugin SDK) from the build_cl.txt beside
       the Client\ or Server\ SDK the configuration compiles against,
       and stored in PluginInfo::gameBuiltCL by plugin_interface.h. It is
       not pinned here, so it follows the headers actually used; a build
       can still pass /p:PluginGameBuiltCL=<CL>.
       ============================================================ -->
  <Import Project="$(PluginSDKInclude)\..\PluginGameBuild.props"
          Condition="Exists('$(PluginSDKInclude)\..\PluginGameBuild.props')" />

  <!-- Rule 3: a plugin never reads a game-class member directly (Plugin SDK tools\Rule3Check.targets).
       Reports until the plugin sets PLUGIN_MAP_MIGRATED, then fails the build. -->
  <PropertyGroup>
    <Rule3Plugin>ServerUtility</Rule3Plugin>
  </PropertyGroup>
  <Import Project="$(PluginSDKInclude)\..\tools\Rule3Check.targets" Condition="Exists('$(PluginSDKInclude)\..\tools\Rule3Check.targets')" />

</Project>
